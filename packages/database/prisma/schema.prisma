// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Raw transcript — append-only, never edited by compaction. Always reflects
  // the full conversation history for audit and replay.
  messages  Json     @default("[]")
  // Working context — what the server actually sends to streamText. Diverges
  // from `messages` once compaction has run. On first compaction this is
  // backfilled from `messages`; from then on both arrays receive new turns.
  workingMessages   Json     @default("[]")
  // Latest compaction digest, injected into the system prompt as a "## Prior
  // conversation digest" block. Null until first compaction.
  compactionSummary String?
  compactionAt      DateTime?
  // Message ids that survive the dropper. Empty until pin UI ships.
  pinnedMessageIds  String[] @default([])
  @@index([userId])
}

// Security-sensitive event log: logout, session create, billing actions,
// credit-gate denials. Intended for forensics and abuse investigation, not
// per-request access logging (pino covers that). Additive — no existing
// model references it.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// Outbox for Polar usage ingest events that failed inline. A background
// sweeper retries pending rows with exponential backoff until completedAt
// is set or attempts exhausts the cap. eventId mirrors the dedupe key we
// pass to Polar so retried sweeps don't double-charge.
model PolarIngestOutbox {
  id          String    @id @default(cuid())
  eventId     String    @unique
  userId      String
  credits     Int
  attempts    Int       @default(0)
  lastAttempt DateTime?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  @@index([completedAt, lastAttempt])
}
