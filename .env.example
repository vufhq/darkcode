API_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=
# Optional: non-pooled endpoint (e.g. Neon direct URL) used by prisma migrate
# only. Leave blank to use DATABASE_URL for both runtime and migrations.
DIRECT_DATABASE_URL=

# Powers the hosted "Kimi K2.6" model.
MOONSHOT_API_KEY=
# Optional overrides:
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
DARKCODE_BACKING_MODEL=kimi-k2.6

# Hosted-provider API keys (optional). When set, DarkCode can run the matching
# models on its own infrastructure and bill the user in credits — so a user
# can pick e.g. Claude or GPT without bringing their own key. Leave a provider
# blank to make its models BYOK-only (the user must add a key with /keys).
# A user's own BYOK key always takes precedence over these and is never metered.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_SECRET=
CLERK_OAUTH_CLIENT_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
JWT_SECRET=

POLAR_ACCESS_TOKEN=
POLAR_PRODUCT_ID=
POLAR_SERVER=sandbox
POLAR_CREDITS_METER_ID=

# Public URL of the website (no trailing slash). Polar redirects users back
# here after checkout / from the customer portal. Defaults to the local
# Vite dev server.
WEBSITE_URL=http://localhost:5173

# CORS allowlist (comma-separated browser origins for the website). Defaults
# to the local Vite dev origin; set to your deployed website origin(s) in
# production. '*' is still honored (credentials auto-disabled) but is no longer
# the default. The CLI is a non-browser client and ignores CORS.
CORS_ORIGINS=http://localhost:5173

# Redis for cross-instance rate limiting + idempotency. Leave empty to fall
# back to per-process memory. The fallback is single-instance only — set
# this before scaling past one replica.
REDIS_URL=

# Observability (optional). Leave SENTRY_DSN empty to disable.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# Graceful-shutdown timeout (ms). Process force-exits if drain doesn't
# complete in time.
SHUTDOWN_TIMEOUT_MS=30000

# Max wall-clock duration (ms) for a single streaming model turn (compaction
# summarizer + main stream). Bounds a hung/trickling upstream. Keep under Bun's
# idleTimeout (255s).
CHAT_STREAM_TIMEOUT_MS=240000

# CLI-side Sentry (optional, separate project recommended).
DARKCODE_SENTRY_DSN=
DARKCODE_VERSION=
